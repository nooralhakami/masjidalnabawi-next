 "rules_ar": {
  "oneway": "كل طريق باتجاه واحد، بترتيب نقاطه (بطلب المالك 2026-10-13). «جميع الطرق يمين»: الحركة تدور يميناً، أي مع عقارب الساعة.",
  "levels": "الطرق نفسها في الدورين: B السفلي وA العلوي. الدخول والخروج الرئيسيان من B فقط. الصعود إلى A بالأصفر بعد موقف 11، والنزول إلى B بالأخضر بين المرفقين 220 و222.",
  "south_exit": "المواقف الجنوبية تخرج إلى الطريق السفلي وتكمل شرقاً، ثم شمالاً إلى الخروج الأحمر في الجهة الشرقية.",
  "west_link": "الوصلة الزرقاء عند y≈894: من طريق الخروج الغربي إلى الحلقة، بدل الذهاب إلى المواقف الجنوبية وأخذ لفة كاملة (بقول المالك).",
  "shared": "البرتقالي في الدور B فقط: فتحة بين مسار الدخول ومسار الخروج لمن غيّر رأيه، تُعبر في الاتجاهين (بتصحيح المالك 2026-10-13).",
  "level_A": "الدور A (بقول المالك): بعد الطلعة الصفراء تتجه السيارة غرباً على الطريق الشمالي، ومنه تدخل المواقف الشمالية (عكس B)، وتخرج منها إلى الطريق الشمالي الداخلي. المواقف الغربية والجنوبية والشرقية كما في B، فيلزم ما يقارب دورة كاملة: نزولاً من الركن الشمالي الغربي إلى الطريق الغربي، ثم الوصلة إلى الحلقة."
